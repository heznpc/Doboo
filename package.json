{
  "name": "doboo-character-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests-js/*.test.mjs",
    "character": "node scripts/character-cli.mjs",
    "test:task-bridge": "node --test task-bridge/*.test.mjs",
    "task:bridge": "node task-bridge/server.mjs",
    "build:device": "python3 scripts/build_device.py",
    "test:device-build": "python3 -m unittest discover -s scripts -p test_build_device.py"
  }
}
